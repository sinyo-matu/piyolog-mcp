AUTH_PASSWORD=change-me
COOKIE_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
PIYOLOG_FEED_URL=https://feed.piyolog.com/v1/feed/28d/FEED_ID/SECRET
CHILD_NAME=Baby
# AUTH_TTL_SECONDS=15552000
# Google ログイン (任意)。CLIENT_ID・SECRET・許可ドメインを設定すると
# 認可画面に「Google でログイン」が出る。
# GOOGLE_ALLOWED_DOMAINS は Google Workspace の組織ドメイン (例: example.co.jp)。
# GOOGLE_CLIENT_SECRET は .dev.vars からは読まれない。
# `npx wrangler dev --var GOOGLE_CLIENT_SECRET:xxxx` で渡す。
# GOOGLE_CLIENT_ID=
# GOOGLE_ALLOWED_DOMAINS=example.co.jp
